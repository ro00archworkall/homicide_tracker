---
import MapDisplay from '../components/MapDisplay.astro';
import fs from 'fs';
import path from 'path';
import { parse } from 'csv-parse/sync';

const dataRaw = fs.readFileSync(path.resolve('./src/data/city_data.csv'), 'utf-8');
const rankings = parse(dataRaw, { columns: true });

const notWired = rankings.filter(city => city.model === 'NOT_WIRED');

const headerHtml = `<div class="sidebar-row header-row"><span class="rank-col">#</span><span class="name-col"> City</span><span class="hom-col">Homicides_YTD</span><span class="rate-col">Rate</span></div>`;

const notWiredHtml = notWired
  .map(city => `<div class='nw-row'>${city.city}</div>`)
  .join('&nbsp;');

let sidebarHtml = '';
try {
  sidebarHtml = rankings
    .filter(city => city.city && city.rate_per_100k !== 'N/A')
    .map(city => `<div class='sidebar-row'><span class='rank-col' style='background:${city.color};color:#1a1a1a'> ${city.rank}</span><span class='data-box' style='border:1px solid ${city.color}'><span class='name-col'> ${city.city}</span><span class='hom-col'>${city.homicides}</span><span class='rate-col'>${city.rate_per_100k}</span></span></div>`)
    .join('\n');
} catch(e) {
  console.error('sidebar error:', e);
}
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>US Homicide Tracker</title>
    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      html, body {
        height: 100vh;
        overflow: hidden;
        background: #1a1a1a;
        color: #f0ede6;
        font-family: 'Courier New', Courier, monospace;
        font-size: 16px;
      }

      body {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        padding: 8ch 0 0 5ch;
      }

        .title {
          position: fixed;
          top: 2.5rem;
          left: 0 rem;
          font-family: 'Courier New', Courier, monospace;
          font-size: 30px;
          color: #f0ede6;
          border: 1px solid #f0ede6;
          z-index: 50;
          letter-spacing: 0.05em;
          weight: 800;
        }

        #getcsv {
          position: fixed;
          top: 2.5rem;
          left: 31em;
          font-family: 'Courier New', Courier, monospace;
          font-size: 30px;
          color: #4A6FA5;
          border: 1px solid #f0ede6;
          background: #1a1a1a;
          cursor: pointer;
          z-index: 50;
        }

      .map-section {
        flex-shrink: 0;
        position: relative;
      }

        .sidebar-wrapper {
          position: fixed;
          top: 0;
          right: 0;
          display: flex;
          flex-direction: column;
          height: 100vh;
          padding: 0 1rem;
        }

      .sidebar-header {
        flex-shrink: 0;
        background: #1a1a1a;
        color: #f0ede6;
        border-bottom: 2px solid #f0ede6;
        padding: -4rem 1rem 0 1rem; 
        font-size: 20px;
        line-height: 1.4;
      }

      .sidebar-scroll {
        flex: 1;
        overflow-y: scroll;
        font-size: 20px;
        line-height: 1.4;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }

      .sidebar-scroll::-webkit-scrollbar { display: none; }

      .sidebar-row {
        display: block;
        line-height: 1.4;
      }

      .data-box  { display: inline-block; padding: 0 0.5ch; }
      .rank-col  { display: inline-block; width: 4ch;  text-align: left; color: #555; }
      .name-col  { display: inline-block; width: 20ch; }
      .hom-col   { display: inline-block; width: 16ch; text-align: left; }
      .rate-col  { display: inline-block; width: 8ch;  text-align: left; padding-left: 1ch; }

      #resume-btn {
        display: none;
        position: absolute;
        bottom: -30px;
        right: 95px;
        font-family: 'Courier New', Courier, monospace;
        font-size: 13px;
        background: #1a1a1a;
        color: #f0ede6;
        padding: 0.3rem 0.6rem;
        cursor: pointer;
        z-index: 100;
      }

        #legend {
          position: absolute;
          bottom: -30px;
          left: 8px;
          font-family: 'Courier New', Courier, monospace;
          font-size: 16px;
          color: #f0ede6;
          line-height: 1.0;
        }

        .legend-swatch {
          display: inline;
          font-size: 25px;
          line-height: .5;
          vertical-align: baseline;
          margin-right: 0;
        }
        
        .legend-row {
          display: inline;
          margin-right: 0;
        }

        .interact {
          position: absolute;
          bottom: -51px;
          left: 305px;
          font-family: 'Courier New', Courier, monospace;
          font-size: 16px;
          color: #f0ede6;
          line-height: 1.2;
          display: flex;
          white-space: pre;
        }
        .info {
          position: absolute;
          bottom: -51px;
          left: 640px;
          font-family: 'Courier New', Courier, monospace;
          font-size: 16px;
          color: #f0ede6;
          line-height: 1.2;
          display: flex;
          white-space: pre;
        }

        #not-wired-list {
          position: absolute;
          bottom: -240px;
          left: 8px;
          font-family: 'Courier New', Courier, monospace;
          font-size: 9px;
          color: #f0ede6;
          line-height: 1.2;
          display: flex;
          flex-wrap: wrap;
          border: .75px solid #f0ede6;
          width: 68.5rem;
        }
        
        .nw-row {
        }

        .not_labelled {
          position: absolute;
          bottom: -170px;
          left: 8px;
          font-family: 'Courier New', Courier, monospace;
          font-size: 12px;
          color: #f0ede6;
          line-height: 1.2;
          display: flex;
        }
    </style>
  </head>
  <body>
      <div class="title">
       US YTD Homicides for Cities >= 200k residents
      </div>
    <button id="getcsv">CSV↓CSV↓CSV↓</button>
    <div class="map-section">
      <MapDisplay />
        <div id="legend">
          <div class="legend-row">Lesser</div>
          <div class="legend-row"><span class="legend-swatch" style="color:#4A6FA5">█</span> </div>
          <div class="legend-row"><span class="legend-swatch" style="color:#6191B2">█</span> </div>
          <div class="legend-row"><span class="legend-swatch" style="color:#78B0BF">█</span> </div>
          <div class="legend-row"><span class="legend-swatch" style="color:#90CACC">█</span> </div>
          <div class="legend-row"><span class="legend-swatch" style="color:#A8D8D1">█</span> </div>
          <div class="legend-row"><span class="legend-swatch" style="color:#C0E4D8">█</span> </div>
          <div class="legend-row">Greater</div>
        </div>
<div class="interact">                     
|                       Rate
|  Click to Display --> █ City
|                       Raw Total
</div>
<div class="info">                     
|  About:
|  Compilation of Municipal Live API's
|  Live ~ 30 days, else modeled & noted          
</div>
      <button id="resume-btn">resume</button>
      <div class="not_labelled">
      Cities >= 200k Not Reported:
      </div>
      <div id="not-wired-list" set:html={notWiredHtml} />
    </div>
    <div class="sidebar-wrapper">
      <div class="sidebar-header" set:html={headerHtml} />
      <div class="sidebar-scroll" id="sidebar-scroll">
        <div id="sidebar-content" set:html={sidebarHtml} />
      </div>
    </div>
  </body>

  <script>
    document.addEventListener('DOMContentLoaded', () => {

      // ── Sidebar scroll ────────────────────────────────────────────────────
      const sidebar  = document.getElementById('sidebar-scroll');
      const content  = document.getElementById('sidebar-content');
      const LINE_H   = 1.4 * 20;
      const totalH   = content.querySelectorAll('.sidebar-row').length * LINE_H;

      const clone = content.cloneNode(true);
      clone.id = 'sidebar-content-clone';
      sidebar.appendChild(clone);

      let currentScroll = 0;
      let isScrolling   = false;
      let scrollTimeout;
      let autoInterval;

      function jumpToRow(steps, auto = false) {
        if (isScrolling && !auto) return;
        isScrolling = true;
        currentScroll += steps * LINE_H;
        if (currentScroll >= totalH) {
          sidebar.scrollTo({ top: 0, behavior: 'instant' });
          currentScroll = 0;
          setTimeout(() => { isScrolling = false; }, 50);
          return;
        }
        if (currentScroll < 0) {
          currentScroll = totalH - LINE_H;
          sidebar.scrollTo({ top: currentScroll, behavior: 'instant' });
          setTimeout(() => { isScrolling = false; }, 50);
          return;
        }
        sidebar.scrollTo({ top: currentScroll, behavior: 'smooth' });
        setTimeout(() => { isScrolling = false; }, 1500);
      }

      function startAutoScroll() {
        clearInterval(autoInterval);
        autoInterval = setInterval(() => jumpToRow(1, true), 2000);
      }

      sidebar.addEventListener('wheel', (e) => {
        e.preventDefault();
        jumpToRow(e.deltaY > 0 ? 1 : -1);
        clearInterval(autoInterval);
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(startAutoScroll, 3000);
      }, { passive: false });

      startAutoScroll();

      // ── Grid ──────────────────────────────────────────────────────────────
      const grid = {};
      document.querySelectorAll('.char').forEach(span => {
        grid[`${span.dataset.row},${span.dataset.col}`] = span;
      });

      // ── Attach data to markers from sidebar ───────────────────────────────
      const markers = [...document.querySelectorAll('.city-marker')];
      document.querySelectorAll('.sidebar-row').forEach(row => {
        const nameEl = row.querySelector('.name-col');
        if (!nameEl) return;
        const name = nameEl.textContent.trim();
        const hom  = row.querySelector('.hom-col')?.textContent.trim() || '';
        const rate = row.querySelector('.rate-col')?.textContent.trim() || '';
        markers.forEach(m => {
          if (m.dataset.city === name) {
            m.dataset.homicides = hom;
            m.dataset.rate      = rate;
          }
        });
      });

      // ── Flash state ───────────────────────────────────────────────────────
      const FLASH_NAME_MS  = 4000;
      const FLASH_RATE_MS  = 4000;
      const FLASH_BLANK_MS = 12000;

      let flashPaused = false;
      let openMarker  = null;

      const cityState = {};
      markers.forEach(m => {
        cityState[m.dataset.city] = {
          timer:      null,
          startDelay: Math.random() * 10000,
        };
        m._session = 0;
      });

      // ── Grid text helpers ─────────────────────────────────────────────────
      function getCells(marker, text, dir) {
        const r = marker._row, c = marker._col;
        return [...text].map((ch, i) => {
          let key;
          if (dir === 'right') key = `${r},${c + 1 + i}`;
          if (dir === 'above') key = `${r - 1},${c + i}`;
          if (dir === 'below') key = `${r + 1},${c + i}`;
          return { key, ch };
        });
      }

      const spanOwner = new WeakMap();
      const spanOrig  = new WeakMap();

      function writeText(marker, text, dir) {
        if (!text) return;
        const session = marker._session;
        getCells(marker, text, dir).forEach(({ key, ch }) => {
          const span = grid[key];
          if (!span) return;
          const currentOwner = spanOwner.get(span);
          if (currentOwner && currentOwner !== marker) closeMarker(currentOwner);
          if (span.classList.contains('city-marker') && span !== marker) closeMarker(span);
          if (!spanOwner.has(span)) {
            spanOrig.set(span, {
              text:   span.textContent,
              color:  span.style.color,
              weight: span.style.fontWeight,
            });
          }
          spanOwner.set(span, marker);
          span._session         = session;
          span.textContent      = ch;
          span.style.color      = marker._hex;
          span.style.fontWeight = 'bold';
        });
      }

      function clearOwned(marker, session) {
        Object.values(grid).forEach(span => {
          if (spanOwner.get(span) !== marker) return;
          if (session !== undefined && span._session !== session) return;
          const orig = spanOrig.get(span);
          if (orig) {
            span.textContent      = orig.text;
            span.style.color      = orig.color;
            span.style.fontWeight = orig.weight;
          }
          spanOwner.delete(span);
          spanOrig.delete(span);
          span._session = null;
        });
      }

      function closeMarker(marker) {
        const state = cityState[marker.dataset.city];
        if (state) clearTimeout(state.timer);
        marker._session = -1;
        clearOwned(marker);
        if (openMarker === marker) openMarker = null;
      }

      function closeAll() {
        markers.forEach(m => closeMarker(m));
      }

      // ── Flash cycle ───────────────────────────────────────────────────────
      function runFlash(marker) {
        const state = cityState[marker.dataset.city];
        if (!state || flashPaused) return;

        function phase(name) {
          if (flashPaused) return;
          if (name === 'name') {
            marker._session = Date.now();
            const s = marker._session;
            writeText(marker, marker.dataset.name, 'right');
            state.timer = setTimeout(() => {
              clearOwned(marker, s);
              phase('rate');
            }, FLASH_NAME_MS);
          } else if (name === 'rate') {
            marker._session = Date.now();
            const s = marker._session;
            writeText(marker, marker.dataset.rate || '', 'right');
            state.timer = setTimeout(() => {
              clearOwned(marker, s);
              phase('blank');
            }, FLASH_RATE_MS);
          } else {
            state.timer = setTimeout(() => phase('name'), FLASH_BLANK_MS);
          }
        }

        setTimeout(() => phase('name'), state.startDelay);
      }

      // ── Resume button ─────────────────────────────────────────────────────
      const resumeBtn = document.getElementById('resume-btn');

        resumeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          // Clear all open cities first
          closeAll();
          flashPaused = false;
          openMarker  = null;
          resumeBtn.style.display = 'none';
          markers.forEach(m => {
            m._session = 0;
            // Group by column into 5 zones, each zone gets a base delay offset
            const col    = m._col;
            const mapWidth = 120;
            const zone   = Math.floor(col / (mapWidth / 5)); // 0-4
            const zoneDelay = zone * 4000; // each zone starts 4s after previous
            const jitter = Math.random() * 2000;
            cityState[m.dataset.city].startDelay = zoneDelay + jitter;
            runFlash(m);
          });
        });

      // ── Map click ─────────────────────────────────────────────────────────
        document.getElementById('us-map').addEventListener('click', (e) => {
          const marker = e.target.closest('.city-marker');
          if (!marker) return;
        
          if (openMarker === marker) {
            // Same marker clicked — close it
            closeMarker(marker);
            openMarker = null;
            return;
          }
        
          // New marker clicked
          if (!flashPaused) {
            // Was in flash mode — stop all flash, clear all, open this one
            flashPaused = true;
            markers.forEach(m => {
              clearTimeout(cityState[m.dataset.city]?.timer);
              m._session = -1;
            });
            closeAll();
            resumeBtn.style.display = 'block';
          }
          // In non-flash mode — just open, don't close others
        
          openMarker = marker;
          marker._session = Date.now();
          writeText(marker, marker.dataset.homicides || '', 'above');
          writeText(marker, marker.dataset.name,            'right');
          writeText(marker, marker.dataset.rate      || '', 'below');
        });

        // ── Start ─────────────────────────────────────────────────────────────
        markers.forEach(m => {
          const col = m._col;
          const zone = Math.floor(col / (120 / 5));
          const zoneDelay = zone * 4000;
          const jitter = Math.random() * 2000;
          cityState[m.dataset.city].startDelay = zoneDelay + jitter;
          runFlash(m);
        });
            });

        document.getElementById('getcsv').addEventListener('click', () => {
          const rows = [...document.querySelectorAll('.sidebar-row')]
            .filter(row => !row.classList.contains('header-row'))
            .map(row => {
              const rank = row.querySelector('.rank-col')?.textContent.trim();
              const city = row.querySelector('.name-col')?.textContent.trim();
              const hom  = row.querySelector('.hom-col')?.textContent.trim();
              const rate = row.querySelector('.rate-col')?.textContent.trim();
              return `${rank},${city},${hom},${rate}`;
            });
        
          const csv = ['rank,city,homicides,rate_per_100k', ...rows].join('\n');
          const blob = new Blob([csv], { type: 'text/csv' });
          const url  = URL.createObjectURL(blob);
          const a    = document.createElement('a');
          a.href     = url;
          a.download = 'homicide_data.csv';
          a.click();
          URL.revokeObjectURL(url);
        });
  </script>
</html>